# Copy to .env.local for local development. On Vercel, add the same keys under
# Project Settings -> Environment Variables. Never commit real values.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: server only. Never share in chat, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random 32+ character strings (e.g. `openssl rand -hex 32`)
OTP_TOKEN_SECRET=
HASH_SALT=
CRON_SECRET=

# Added in step 4 (notifications)
# EMAIL_API_KEY=
# SMS_API_KEY=
# WHATSAPP_PROVIDER_API_KEY=
# WHATSAPP_WEBHOOK_SECRET=
